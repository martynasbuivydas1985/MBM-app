#!/bin/sh

APP_DIR=$(cd "$(dirname "$0")" && pwd -P)
CLASSPATH="$APP_DIR/gradle/wrapper/gradle-wrapper.jar:$APP_DIR/gradle/wrapper/gradle-wrapper-shared.jar:$APP_DIR/gradle/wrapper/gradle-cli.jar"

if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA_CMD="$JAVA_HOME/bin/java"
else
  JAVA_CMD="java"
fi

exec "$JAVA_CMD" -Dorg.gradle.appname=gradlew \
  -classpath "$CLASSPATH" \
  org.gradle.wrapper.GradleWrapperMain "$@"
